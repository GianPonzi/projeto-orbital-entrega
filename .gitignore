# Monorepo: o app Next vive em frontend/ — os caminhos ancorados dele levam o prefixo.

# dependencies
/frontend/node_modules
/frontend/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/frontend/coverage

# next.js
/frontend/.next/
/frontend/out/

# production
/frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/frontend/generated/prisma

# python (backend/)
__pycache__/
*.pyc
.venv/

# Material pessoal, fora da entrega: o repositório leva só o necessário para
# rodar o projeto (ver README.md).
/testes/
/documentacao_projeto/
/AGENTS.md
/CLAUDE.md
/frontend/README.md
/frontend/data/companies.json
/frontend/data/relations.json

# skills do Prisma para agentes de IA — baixadas pelo `prisma init`, consultáveis
# sob demanda. Os arquivos reais ficam em .agents/; .claude/skills são symlinks.
/.agents/
/.claude/skills/
/skills-lock.json
